# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA_DATAMALL_KEY / LTA_ACCOUNT_KEY: Land Transport Authority Singapore DataMall API Key.
# Obtain your free 32-character key at https://datamall.lta.gov.sg/
# Passed via the 'AccountKey' header to LTA DataMall endpoints.
LTA_DATAMALL_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"
